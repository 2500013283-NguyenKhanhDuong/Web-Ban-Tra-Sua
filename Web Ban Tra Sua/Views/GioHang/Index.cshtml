@model IEnumerable<WebBanTraSua.Models.CartItem>

@{
    ViewBag.Title = "Giỏ Hàng";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Trà Sữa Dương</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #fffaf0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar-custom {
            background-color: #5e3023;
            box-shadow: 0 4px 6px rgba(0,0,0,0.15);
            padding: 12px 0;
        }

        .navbar-brand {
            font-size: 1.5rem;
            font-weight: 900;
            color: #faedcd !important;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .footer-custom {
            background-color: #5e3023;
            color: #faedcd;
            padding: 40px 0 20px;
            margin-top: auto;
        }

        .cart-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(212, 163, 115, 0.2);
            padding: 40px;
            margin-top: 40px;
            margin-bottom: 40px;
        }

        .table-cart th {
            background-color: #faedcd;
            color: #5e3023;
            border: none;
            padding: 15px;
        }

        .table-cart td {
            vertical-align: middle;
            border-bottom: 1px dashed #e6d5c3;
            padding: 15px;
        }

        .btn-checkout {
            background: linear-gradient(135deg, #e76f51, #f4a261);
            border: none;
            color: white;
            font-weight: bold;
            border-radius: 30px;
            padding: 12px 30px;
            transition: 0.3s;
        }

            .btn-checkout:hover {
                opacity: 0.9;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231,111,81,0.4);
                color: white;
            }

        .btn-remove {
            color: #dc3545;
            background: #ffebee;
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: 0.3s;
        }

            .btn-remove:hover {
                background: #dc3545;
                color: white;
                transform: scale(1.1);
            }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/TraSua"><i class="fa-solid fa-mug-hot me-2 text-warning"></i>Trà Sữa Dương</a>
            <div class="d-flex align-items-center">
                <a class="btn btn-outline-light border-2 fw-bold rounded-pill me-3 px-4" href="/TraSua">
                    <i class="fa-solid fa-house me-1"></i> Trang Chủ
                </a>
            </div>
        </div>
    </nav>

    <div class="container cart-container">
        <h2 class="text-center fw-bold mb-5" style="color: #5e3023;"><i class="fa-solid fa-basket-shopping me-3"></i>Giỏ Hàng Của Bạn</h2>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-cart-arrow-down text-muted mb-3" style="font-size: 70px; color: #d4a373 !important;"></i>
                <h4 class="text-muted mt-3">Giỏ hàng đang trống!</h4>
                <a href="/TraSua" class="btn btn-checkout mt-4"><i class="fa-solid fa-arrow-left me-2"></i>Quay Lại Menu</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-cart text-center">
                    <thead class="rounded">
                        <tr>
                            <th class="text-start">Tên sản phẩm</th>
                            <th>Giá tiền</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-start">
                                    <div class="d-flex align-items-center">
                                        <img src="@item.HinhAnh" alt="@item.TenSanPham" class="rounded shadow-sm me-3" style="width: 70px; height: 70px; object-fit: cover;">
                                        <span class="fw-bold" style="color: #5e3023; font-size: 1.1rem;">@item.TenSanPham</span>
                                    </div>
                                </td>
                                <td class="text-danger fw-bold align-middle">@item.DonGia.ToString("N0")đ</td>
                                <td class="align-middle"><span class="badge bg-secondary px-3 py-2 fs-6 rounded-pill">@item.SoLuong</span></td>
                                <td class="text-danger fw-bold fs-5 align-middle">@item.ThanhTien.ToString("N0")đ</td>
                                <td class="align-middle">
                                    <button type="button" class="btn-remove" onclick="xoaHoanToan(@item.SanPhamId)" title="Gỡ bỏ sản phẩm">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top border-2">
                <h3 class="fw-bold mb-0" style="color: #5e3023;">Tổng tiền giỏ hàng: <span class="text-danger fs-2 ms-2">@ViewBag.TongTien.ToString("N0")đ</span></h3>
                <div>
                    <a href="/TraSua" class="btn btn-outline-dark fw-bold rounded-pill px-4 py-2 me-3"><i class="fa-solid fa-arrow-rotate-left me-2"></i>Tiếp tục mua</a>
                    <a href="/GioHang/ThanhToan" class="btn btn-checkout px-5"><i class="fa-solid fa-credit-card me-2"></i>Thanh Toán Ngay</a>
                </div>
            </div>
        }
    </div>

    <footer class="footer-custom">
        <div class="container text-center">
            <h4 class="fw-bold mb-3"><i class="fa-solid fa-mug-hot me-2"></i>Trà Sữa Dương</h4>
            <p class="mb-1">Hệ thống đồ uống thiết kế với kiến trúc MVC</p>
            <p class="small text-white-50">© 2026 - Bản quyền thuộc về sinh viên thực hiện đồ án</p>
        </div>
    </footer>

    <script>
        function xoaHoanToan(idSanPham) {
            if(confirm("Bạn có chắc chắn muốn gỡ bỏ sản phẩm này khỏi giỏ hàng?")) {
                fetch('/GioHang/XoaKhoiGioAjax', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + idSanPham
                }).then(response => response.json()).then(data => {
                    if (data.success) { window.location.reload(); }
                });
            }
        }
    </script>
</body>
</html>