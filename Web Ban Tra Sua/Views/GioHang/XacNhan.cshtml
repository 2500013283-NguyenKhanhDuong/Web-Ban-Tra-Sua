@model IEnumerable<WebBanTraSua.Models.CartItem>

@{
    ViewBag.Title = "Hóa Đơn Mua Hàng";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Trà Sữa Dương</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #fffaf0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar-custom {
            background-color: #5e3023;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            padding: 12px 0;
        }

        .navbar-brand {
            font-size: 1.5rem;
            font-weight: 900;
            color: #faedcd !important;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .content-wrapper {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 0;
        }

        .receipt-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 15px 35px rgba(212, 163, 115, 0.2);
            padding: 40px;
            width: 100%;
            max-width: 600px;
            border: none;
            position: relative;
        }

            .receipt-card::before {
                content: "";
                position: absolute;
                top: -10px;
                left: 0;
                width: 100%;
                height: 20px;
                background-image: radial-gradient(circle at 10px 0, transparent 10px, white 11px);
                background-size: 20px 20px;
                background-repeat: repeat-x;
            }

            .receipt-card::after {
                content: "";
                position: absolute;
                bottom: -10px;
                left: 0;
                width: 100%;
                height: 20px;
                background-image: radial-gradient(circle at 10px 20px, transparent 10px, white 11px);
                background-size: 20px 20px;
                background-repeat: repeat-x;
            }

        .success-icon {
            font-size: 50px;
            color: #4caf50;
            margin-bottom: 15px;
        }

        .receipt-title {
            color: #5e3023;
            font-weight: 900;
            font-size: 2rem;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .receipt-info {
            border-bottom: 2px dashed #d4a373;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }

        .receipt-item {
            border-bottom: 1px dashed #e6d5c3;
            padding: 10px 0;
        }

        .receipt-total {
            border-top: 2px solid #5e3023;
            padding-top: 15px;
            margin-top: 15px;
        }

        .btn-home {
            background: linear-gradient(135deg, #e76f51, #f4a261);
            border: none;
            color: white;
            font-weight: bold;
            border-radius: 30px;
            padding: 12px 30px;
            transition: 0.3s;
            font-size: 1.1rem;
            text-decoration: none;
            display: inline-block;
        }

            .btn-home:hover {
                opacity: 0.9;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231,111,81,0.4);
                color: white;
            }

        .footer-custom {
            background-color: #5e3023;
            color: #faedcd;
            padding: 40px 0 20px;
            margin-top: auto;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="navbar-brand text-decoration-none" href="/TraSua"><i class="fa-solid fa-mug-hot me-2 text-warning"></i>Trà Sữa Dương</a>
            <div class="d-flex align-items-center">
                <a class="btn btn-outline-light border-2 fw-bold rounded-pill px-4 shadow-sm" href="/TraSua">
                    <i class="fa-solid fa-house me-1"></i> Trang Chủ
                </a>
            </div>
        </div>
    </nav>

    <div class="content-wrapper container">
        <div class="card receipt-card">
            <div class="text-center">
                <i class="fa-solid fa-circle-check success-icon"></i>
                <h2 class="receipt-title">Đặt Hàng Thành Công</h2>
                <div class="receipt-info text-muted">
                    Xin chào <strong>@(ViewBag.HoTen)</strong>, đơn hàng của bạn đã được ghi nhận.
                </div>
            </div>

            <h5 class="fw-bold mb-3 text-secondary">Danh sách sản phẩm đã thanh toán:</h5>
            <div class="mb-4">
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <div class="receipt-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold text-dark">@item.TenSanPham</div>
                                <div class="small text-muted">@item.SoLuong x @item.DonGia.ToString("N0")đ</div>
                            </div>
                            <div class="fw-bold text-danger">@item.ThanhTien.ToString("N0")đ</div>
                        </div>
                    }
                }
            </div>

            <div class="receipt-total d-flex justify-content-between align-items-center mb-4">
                <span class="fs-5 fw-bold text-uppercase" style="color: #5e3023;">Tổng tiền thanh toán:</span>
                <span class="fs-3 fw-bold text-danger">@(ViewBag.TongTien != null ? ((int)ViewBag.TongTien).ToString("N0") : "0")đ</span>
            </div>

            <div class="text-center mt-4">
                <a href="/TraSua" class="btn btn-home"><i class="fa-solid fa-arrow-left me-2"></i>Tiếp Tục Mua Sắm</a>
            </div>
        </div>
    </div>

    <footer class="footer-custom">
        <div class="container text-center">
            <h4 class="fw-bold mb-3"><i class="fa-solid fa-mug-hot me-2"></i>Trà Sữa Dương</h4>
            <p class="mb-1">Hệ thống đồ uống thiết kế với kiến trúc MVC</p>
            <p class="small text-white-50">© 2026 - Bản quyền thuộc về sinh viên thực hiện đồ án</p>
        </div>
    </footer>
</body>
</html>