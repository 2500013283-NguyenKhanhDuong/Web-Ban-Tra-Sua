@model WebBanTraSua.Models.TaiKhoan

@{
    ViewBag.Title = "Đăng Nhập Quản Trị";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Trà Sữa Dương</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #fffaf0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        .bubble-background {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: 0;
        }

        .floating-icon {
            position: absolute;
            bottom: -100px;
            color: rgba(212, 163, 115, 0.3);
            animation: floatUpDiagonal linear infinite;
        }

        @@keyframes floatUpDiagonal {
            0% {
                transform: translateY(0) translateX(0) rotate(0deg);
                opacity: 0;
            }

            15% {
                opacity: 0.9;
            }

            85% {
                opacity: 0.9;
            }

            100% {
                transform: translateY(-110vh) translateX(180px) rotate(360deg);
                opacity: 0;
            }
        }

        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 25px;
            box-shadow: 0 15px 35px rgba(212, 163, 115, 0.3);
            padding: 40px;
            width: 100%;
            max-width: 450px;
            border: none;
            z-index: 10;
        }

        .login-title {
            color: #5e3023;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 1.8rem;
        }

        .form-control {
            border-radius: 12px;
            padding: 12px 15px;
            border: 1px solid #d4a373;
        }

            .form-control:focus {
                box-shadow: 0 0 0 0.25rem rgba(212, 163, 115, 0.25);
                border-color: #d4a373;
            }

        .btn-login {
            background: linear-gradient(135deg, #e76f51, #f4a261);
            border: none;
            color: white;
            font-weight: bold;
            border-radius: 30px;
            padding: 12px;
            transition: 0.3s;
            font-size: 1.1rem;
        }

            .btn-login:hover {
                opacity: 0.9;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231,111,81,0.4);
                color: white;
            }

        .btn-back {
            background: transparent;
            border: 2px solid #5e3023;
            color: #5e3023;
            font-weight: bold;
            border-radius: 30px;
            padding: 10px;
            transition: 0.3s;
        }

            .btn-back:hover {
                background: #5e3023;
                color: white;
            }

        .login-icon {
            font-size: 50px;
            color: #e76f51;
            margin-bottom: 15px;
        }

        .hint-box {
            background-color: #faedcd;
            border-radius: 12px;
            padding: 10px;
            font-size: 0.85rem;
            color: #5e3023;
            margin-bottom: 20px;
            border: 1px dashed #d4a373;
        }
    </style>
</head>
<body>
    <div class="bubble-background">
        <i class="fa-solid fa-mug-hot floating-icon" style="left: 3%; font-size: 32px; animation-duration: 7s; animation-delay: 0s;"></i>
        <i class="fa-solid fa-leaf floating-icon" style="left: 10%; font-size: 22px; animation-duration: 9s; animation-delay: 1.5s;"></i>
        <i class="fa-solid fa-circle floating-icon" style="left: 18%; font-size: 16px; animation-duration: 6s; animation-delay: 0.5s;"></i>
        <i class="fa-solid fa-cup-togo floating-icon" style="left: 27%; font-size: 38px; animation-duration: 8s; animation-delay: 2s;"></i>
        <i class="fa-solid fa-stroopwafel floating-icon" style="left: 35%; font-size: 28px; animation-duration: 7.5s; animation-delay: 1s;"></i>
        <i class="fa-solid fa-circle floating-icon" style="left: 42%; font-size: 20px; animation-duration: 6.5s; animation-delay: 2.5s;"></i>
        <i class="fa-solid fa-mug-hot floating-icon" style="left: 50%; font-size: 40px; animation-duration: 8.5s; animation-delay: 0.8s;"></i>
        <i class="fa-solid fa-leaf floating-icon" style="left: 58%; font-size: 25px; animation-duration: 7s; animation-delay: 1.8s;"></i>
        <i class="fa-solid fa-circle floating-icon" style="left: 66%; font-size: 18px; animation-duration: 9.5s; animation-delay: 3s;"></i>
        <i class="fa-solid fa-cup-togo floating-icon" style="left: 74%; font-size: 35px; animation-duration: 6s; animation-delay: 0.2s;"></i>
        <i class="fa-solid fa-stroopwafel floating-icon" style="left: 82%; font-size: 26px; animation-duration: 8s; animation-delay: 1.2s;"></i>
        <i class="fa-solid fa-circle floating-icon" style="left: 89%; font-size: 15px; animation-duration: 7s; animation-delay: 2.2s;"></i>
        <i class="fa-solid fa-mug-hot floating-icon" style="left: 95%; font-size: 30px; animation-duration: 6.8s; animation-delay: 0.7s;"></i>
    </div>

    <div class="container d-flex justify-content-center">
        <div class="card login-card text-center">
            <div>
                <i class="fa-solid fa-mug-hot login-icon"></i>
                <h3 class="login-title mb-2">Quản Trị Hệ Thống</h3>
                <p class="text-muted small mb-3">Đăng nhập để quản lý cửa hàng Trà Sữa Dương</p>

                <!-- Gợi ý tài khoản nhanh cho bạn -->
                <div class="hint-box">
                    <i class="fa-solid fa-circle-info me-1"></i> Tài khoản mẫu: <strong>admin</strong> | Mật khẩu: <strong>123456</strong>
                </div>
            </div>

            @if (ViewBag.Loi != null)
            {
                <div class="alert alert-danger rounded-pill py-2 small fw-bold">@ViewBag.Loi</div>
            }

            <form method="post" action="/TaiKhoan/DangNhap" class="text-start">
                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary small">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3"><i class="fa-solid fa-user text-muted"></i></span>
                        <input type="text" name="TenDangNhap" class="form-control border-start-0 rounded-end-pill" value="admin" required />
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary small">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3"><i class="fa-solid fa-lock text-muted"></i></span>
                        <input type="password" name="MatKhau" class="form-control border-start-0 rounded-end-pill" value="123456" required />
                    </div>
                </div>
                <button type="submit" class="btn btn-login w-100 mb-3 shadow-sm"><i class="fa-solid fa-right-to-bracket me-2"></i>Đăng Nhập Ngay</button>
                <a href="/TraSua" class="btn btn-back w-100 fw-bold"><i class="fa-solid fa-arrow-left me-2"></i>Quay lại trang chủ</a>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>